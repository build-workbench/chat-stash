# Public Supabase configuration. Never put secret or service-role keys here.
# Plasmo injects PLASMO_PUBLIC_* variables into the extension bundle.
PLASMO_PUBLIC_SUPABASE_URL=
PLASMO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the ChatStash Web app (used for sign-up / recovery links from the popup).
PLASMO_PUBLIC_WEB_URL=http://localhost:3000
# Enable the dev/test synthetic adapter and fixture host (Stage 6). Leave empty in production.
PLASMO_PUBLIC_ENABLE_SYNTHETIC=
